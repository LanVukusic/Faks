%%BeginProlog
/labelfontsize 12 def
/txtlt { /font_size exch def gsave dup 0 -1 font_size mul rmoveto show grestore } def
/txtlm { /font_size exch def gsave dup 0 font_size 2 div -1 mul rmoveto show grestore } def
/txtlb { /font_size exch def gsave dup 0 0 rmoveto show grestore } def
/txtct { /font_size exch def gsave dup stringwidth exch 2 div -1 mul exch pop font_size -1 mul rmoveto show grestore } def
/txtcm { /font_size exch def gsave dup stringwidth exch 2 div -1 mul exch pop font_size 2 div -1 mul rmoveto show grestore } def
/txtcb { /font_size exch def gsave dup stringwidth pop 2 div -1 mul 0 rmoveto show grestore } def
/txtrt { /font_size exch def gsave dup stringwidth exch -1 mul exch pop font_size -1 mul rmoveto show grestore } def
/txtrm { /font_size exch def gsave dup stringwidth exch -1 mul exch pop font_size 2 div -1 mul rmoveto show grestore } def
/txtrb { /font_size exch def gsave dup stringwidth exch -1 mul exch pop 0 rmoveto show grestore } def
/point {} def
%/point { -3 -3 rmoveto 6 6 rlineto -6 0 rmoveto 6 -6 rlineto -3 3 rmoveto } def

%xTop yTop xBot yBot tracebox
/tracebox
  {
  /yBot exch def
  /xBot exch def
  /yTop exch def
  /xTop exch def

  gsave
  0.00 0.50 0.00 setrgbcolor
  newpath
  xTop yTop moveto
  xBot yTop lineto
  xBot yBot lineto
  xTop yBot lineto
  closepath stroke
  grestore
  } def

%xMin xL xR xMax yTop yBot (label) honeycomb
/honeycomb
  {
  /label exch def
  /yBot exch def
  /yTop exch def
  /xMax exch def
  /xR exch def
  /xL exch def
  /xMin exch def

  /yMid yBot yTop add 2 div def

  gsave
  newpath
  0.90 0.90 0.90 setrgbcolor
  xMin yMid moveto xL yTop lineto xR yTop lineto xMax yMid lineto xR yBot lineto xL yBot lineto
  closepath
  fill
  grestore

  gsave
  newpath
  xMin yMid moveto xL yTop lineto xR yTop lineto xMax yMid lineto xR yBot lineto xL yBot lineto
  closepath
  stroke
  newpath
  xL xR add 2 div yMid moveto
  (Helvetica) findfont labelfontsize scalefont setfont
  label labelfontsize txtcm
  stroke
  grestore
  } def

2 setlinejoin 2 setlinecap
%%EndProlog
