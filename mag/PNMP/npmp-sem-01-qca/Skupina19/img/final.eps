%%Creator: QCADesigner
%%EndComments
%%BeginProlog
/epsilon 0.1 def
/nm { 0.908012 mul } def
/labelfontsize 12 nm def

% a b min
/min
  {
  /b exch def
  /a exch def

  a b lt { a } { b } ifelse
  } def

% a b max
/max
  {
  /b exch def
  /a exch def

  a b gt { a } { b } ifelse
  } def

/linewidth 0.1 nm 1 min def

% (string) txt??
/txtlt { gsave dup 0 -1 labelfontsize mul rmoveto show grestore } def
/txtlm { gsave dup 0 labelfontsize 2 div -1 mul rmoveto show grestore } def
/txtlb { gsave dup 0 0 rmoveto show grestore } def
/txtct { gsave dup stringwidth exch 2 div -1 mul exch pop labelfontsize -1 mul rmoveto show grestore } def
/txtcm { gsave dup stringwidth exch 2 div -1 mul exch pop labelfontsize 2 div -1 mul rmoveto show grestore } def
/txtcb { gsave dup stringwidth pop 2 div -1 mul 0 rmoveto show grestore } def
/txtrt { gsave dup stringwidth exch -1 mul exch pop labelfontsize -1 mul rmoveto show grestore } def
/txtrm { gsave dup stringwidth exch -1 mul exch pop labelfontsize 2 div -1 mul rmoveto show grestore } def
/txtrb { gsave dup stringwidth exch -1 mul exch pop 0 rmoveto show grestore } def
1 setlinejoin
1 setlinecap
linewidth setlinewidth

% x y cx cy r g b (label) QCADLabel
/QCADLabel
  {
  gsave
  /label exch def
  /b exch def
  /g exch def
  /r exch def
  /cy exch def
  /cx exch def
  /y exch def
  /x exch def

  newpath
  x y moveto
  x cx add y lineto
  x cx add y cy sub lineto
  x y cy sub lineto
  closepath clip

  r g b setrgbcolor


  x y moveto
  (Helvetica) findfont labelfontsize scalefont setfont
  label txtlt
  grestore
  } def

/point
  {
  /y exch def
  /x exch def

  newpath
  x 3 sub y 3 sub moveto
  x 3 add y 3 add lineto
  x 3 sub y 3 add moveto
  x 3 add y 3 sub lineto
  stroke
  }

% x y cx cy dot_diam dot0_x dot0_y dot1_x dot1_y dot2_x dot2_y dot3_x dot3_y charge0_diam charge1_diam charge2_diam charge3_diam r g b mode QCADCell
/QCADCell
  {
  gsave
  /mode exch def
  /b exch def
  /g exch def
  /r exch def
  /charge3_diam exch def
  /charge2_diam exch def
  /charge1_diam exch def
  /charge0_diam exch def
  /dot3_y exch def
  /dot3_x exch def
  /dot2_y exch def
  /dot2_x exch def
  /dot1_y exch def
  /dot1_x exch def
  /dot0_y exch def
  /dot0_x exch def
  /dot_diam exch def
  /cy exch def
  /cx exch def
  /y exch def
  /x exch def

  % Filler
  newpath
  x y moveto
  x cx add y lineto
  x cx add y cy sub lineto
  x y cy sub lineto
  x y lineto
  mode 0 eq dot_diam epsilon gt and
    {
    dot0_x dot_diam 2 div add dot0_y moveto
    dot0_x dot0_y dot_diam 2 div 0 360 arc
    dot1_x dot_diam 2 div add dot1_y moveto
    dot1_x dot1_y dot_diam 2 div 0 360 arc
    dot2_x dot_diam 2 div add dot2_y moveto
    dot2_x dot2_y dot_diam 2 div 0 360 arc
    dot3_x dot_diam 2 div add dot3_y moveto
    dot3_x dot3_y dot_diam 2 div 0 360 arc
    }
  if
  r g b setrgbcolor
  fill
  grestore

  linewidth epsilon gt
    {
    % Cell outline
    newpath
    x y moveto
    x cx add y lineto
    x cx add y cy sub lineto
    x y cy sub lineto
    closepath
    stroke
    }
  if

  gsave

  mode 0 eq
    {
    linewidth epsilon gt
      {
      %dot0 outline
      newpath
      dot0_x dot0_y dot_diam 2 div 0 360 arc
      closepath stroke

      %dot1 outline
      newpath
      dot1_x dot1_y dot_diam 2 div 0 360 arc
      closepath stroke

      %dot2 outline
      newpath
      dot2_x dot2_y dot_diam 2 div 0 360 arc
      closepath stroke

      %dot3 outline
      newpath
      dot3_x dot3_y dot_diam 2 div 0 360 arc
      closepath stroke
      }
    if

    dot_diam epsilon gt
      {
      %dot0 charge
      newpath
      dot0_x dot0_y charge0_diam 2 div 0 360 arc
      closepath fill

      %dot1 charge
      newpath
      dot1_x dot1_y charge1_diam 2 div 0 360 arc
      closepath fill

      %dot2 charge
      newpath
      dot2_x dot2_y charge2_diam 2 div 0 360 arc
      closepath fill

      %dot3 charge
      newpath
      dot3_x dot3_y charge3_diam 2 div 0 360 arc
      closepath fill
      }
    if
    }
    {
    linewidth epsilon gt
      {
      mode 1 eq
        {
        % draw an X across the cell
        newpath
        x y moveto
        x cx add y cy sub lineto
        stroke

        newpath
        x cx add y moveto
        x y cy sub lineto
        stroke
        }
        {
        % draw a circle
        newpath
        x cx 2 div add y cy 2 div sub cx 2 div 0 360 arc
        closepath stroke
        }
      ifelse
      } % linewidth epsilon gt
    if
    }
  ifelse

  grestore
  } def

%%EndProlog
